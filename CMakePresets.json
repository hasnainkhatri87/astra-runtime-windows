{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/build/win-x64-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/AstraRuntime",
        "ASTRA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
